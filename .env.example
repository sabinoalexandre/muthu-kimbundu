# MUTHU configuration
# Copy this file to `.env` and adjust the values.

# Initial translation strategy: "dictionary" or "machine".
# No machine translation service has been verified to support Kimbundu yet,
# so the dictionary strategy is the only implemented provider.
TRANSLATION_PROVIDER=dictionary

# Application theme: "light" or "dark".
MUTHU_THEME=light

# Default language pair (must be supported and different).
MUTHU_DEFAULT_SOURCE=pt
MUTHU_DEFAULT_TARGET=kimbundu

# External translation API credentials.
# Do not commit real keys. Services such as DeepL or Google Translate have
# not been verified to support Kimbundu, so no provider key is required yet.
# DEEPL_API_KEY=
